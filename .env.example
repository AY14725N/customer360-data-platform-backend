APP_NAME=Customer 360 API
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Use localhost when running the API directly; Compose overrides this to postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer360
POSTGRES_USER=customer360
POSTGRES_PASSWORD=customer360
# Host-side clients connect here; Compose overrides this to kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_GROUP_ID=customer360
RAW_STORAGE_PATH=storage/raw
MODEL_PATH=ml/models/churn_model.joblib
